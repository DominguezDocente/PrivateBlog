@using PrivateBlog.Web.Data.Entities;
@inject PrivateBlog.Web.Services.Abstractions.IUsersService _usersService;

@{
    User? user = null;

    string email = User?.Identity?.Name;

    if (!string.IsNullOrEmpty(email))
    {
        var userResponse = await _usersService.GetUserByEmailAsync(email);

        if (userResponse.IsSuccess)
        {
            user = userResponse.Result;
        }
    }
}

<header id="header" class="header fixed-top d-flex align-items-center">

    <div class="d-flex align-items-center justify-content-between">
        <a href="index.html" class="logo d-flex align-items-center">
            <img src="~/assets/img/logo.png" alt="">
            <span class="d-none d-lg-block">PrivateBlog</span>
        </a>
        <i class="bi bi-list toggle-sidebar-btn"></i>
    </div>

    <div class="search-bar">
        <form class="search-form d-flex align-items-center" method="POST" action="#">
            <input type="text" name="query" placeholder="Search" title="Enter search keyword">
            <button type="submit" title="Search"><i class="bi bi-search"></i></button>
        </form>
    </div>

    <nav class="header-nav ms-auto">
        <ul class="d-flex align-items-center">

            <li class="nav-item dropdown pe-3">

                @if(user is not null)
                {

                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                        <img src="~/assets/img/profile-img.jpg" alt="Profile" class="rounded-circle">
                        <span class="d-none d-md-block dropdown-toggle ps-2">@user?.FirstName.Substring(0, 1) . @user?.LastName</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>@user?.FullName</h6>
                            <span>@user?.PrivateBlogRole?.Name</span>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="UpdateUser">
                                <i class="bi bi-person"></i>
                                <span>Mi Perfil</span>
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-action="Logout" asp-controller="Account">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Cerrar Sesión</span>
                            </a>
                        </li>
                    </ul>
                }
                else
                {
                    <li>
                        <a class="dropdown-item d-flex align-items-center" asp-action="Login" asp-controller="Account">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Iniciar Sesión</span>
                        </a>
                    </li>
                }
            </li>

        </ul>
    </nav>

</header>