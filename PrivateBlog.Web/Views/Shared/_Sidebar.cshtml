@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

        <li class="nav-item">
            <a class="nav-link @(controller == "Home" ? "" : "collapsed")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid"></i>
                <span>Dashboard</span>
            </a>
        </li>
        
        <li class="nav-item">
            <a class="nav-link @(controller == "Sections" ? "" : "collapsed")" asp-controller="Sections" asp-action="Index">
                <i class="bi bi-grid"></i>
                <span>Secciones</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link @(controller == "Blogs" ? "" : "collapsed")" asp-controller="Blogs" asp-action="Index">
                <i class="bi bi-journal-text"></i>
                <span>Blogs</span>
            </a>
        </li>

        @{
            string? userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        }

        @if (userId != null && await Mediator.Send(new UserHasPermissionQuery { UserId = userId, PermissionCode = PermissionCodesCatalog.ShowRoles }))
        {
            <li class="nav-item">
                <a class="nav-link @(controller == "Roles" ? "" : "collapsed")" asp-controller="Roles" asp-action="Index">
                    <i class="bi bi-shield-lock"></i>
                    <span>Roles</span>
                </a>
            </li>
        }

        @if (userId != null && await Mediator.Send(new UserHasPermissionQuery { UserId = userId, PermissionCode = PermissionCodesCatalog.ShowUsers }))
        {
            <li class="nav-item">
                <a class="nav-link @(controller == "Users" ? "" : "collapsed")" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Usuarios</span>
                </a>
            </li>
        }
    </ul>

</aside>