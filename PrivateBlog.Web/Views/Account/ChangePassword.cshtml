@model ChangePasswordDTO

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Profile">Mi Perfil</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <h3 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h3>
        </div>
        <div class="card-body mt-3">
            <form asp-action="ChangePassword" method="POST" class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="CurrentPassword" class="form-control" placeholder="Contraseña actual" />
                        <label asp-for="CurrentPassword"></label>
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="NewPassword" class="form-control" placeholder="Nueva contraseña" />
                        <label asp-for="NewPassword"></label>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Confirmar nueva contraseña" />
                        <label asp-for="ConfirmNewPassword"></label>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-action="Profile" class="btn btn-secondary">Volver</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
