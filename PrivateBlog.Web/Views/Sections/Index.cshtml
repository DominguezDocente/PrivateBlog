@inject IAccountService _accountService;
@model PaginationResponse<SectionDTO>

@{
    ViewData["Title"] = "Secciones";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">
            
            <div class="row">

                <h3 class="m-0 font-weight-bold text-primary col-md-11">@ViewData["Title"]</h3>
                    
                @if (await _accountService.AccountUserIsAuthorizedAsync("sections.create"))
                {
                    <div class="col-md-1">
                        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i></a>
                    </div>
                }

            </div>

        </div>

        <div class="card-body mt-3">
            
            <form asp-action="Index" class="navbar-search" method="GET">

                <input type="hidden" name="Page" value="@Model.CurrentPage" />

                <div class="row mt-3">
                        
                    <div class="col-md-auto">                            
                        <select asp-for="RecordsPerPage" class="form-select bg-light border-0 small">
                            <option value="2" selected="@(Model.RecordsPerPage == 2)">2</option>
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>

                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text"
                                   class="form-control bg-light border-0 small"
                                   placeholder="Buscar..."
                                   aria-label="search"
                                   asp-for="Filter" />

                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                </div>

            </form>

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>Sección</th>
                        <th>Descripción</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach(SectionDTO item in Model.List)
                    {
                        string rowClass = item.IsHidden ? "table-secondary" : "";
                        
                        <tr class="@rowClass">
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>
                                @if (await _accountService.AccountUserIsAuthorizedAsync("sections.update"))
                                {
                                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    @if (item.IsHidden)
                                    {
                                        <form asp-action="Toggle" method="POST" style="display: contents;">
                                            <input type="hidden" name="SectionId" value="@item.Id" />
                                            <input type="hidden" name="Hide" value="false" />

                                            <button class="btn btn-sm btn-secondary"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            data-bs-original-title="Desocultar">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Toggle" method="POST" style="display: contents;">
                                            <input type="hidden" name="SectionId" value="@item.Id" />
                                            <input type="hidden" name="Hide" value="true" />

                                            <button class="btn btn-sm btn-info"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            data-bs-original-title="Ocultar">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        </form>
                                    }
                                }
                                @if (await _accountService.AccountUserIsAuthorizedAsync("sections.delete"))
                                {
                                    <form asp-action="Delete" method="POST" style="display: contents;" asp-route-Id="@item.Id">
                                        <button type="submit" class="btn btn-sm btn-danger btnDelete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

            @await Html.PartialAsync("_PaginationComponent", Model)

        </div>
    </div>

</section>

@section Scripts {

    <script>

        $(document).ready(function() {

            $('.btnDelete').click(function(event) {

                event.preventDefault();

                Swal.fire({
                    icon: 'question',
                    title: '¿Delea eliminar la sección?',
                    text: "¡No podrás revertir esto!",
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'

                }).then((result) => {

                    if (result.isConfirmed) {

                        const form = $(this).closest('form');
                        form.submit();
                    }
                });
            });
        });

    </script>

}