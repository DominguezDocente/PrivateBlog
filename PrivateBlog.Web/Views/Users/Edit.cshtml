@model UserDTO

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="pagetitle">
    <h1>Usuarios</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Usuarios</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>


<section class="section dashboard">


    <div class="card">
        <div class="card-body">
            <h5 class="card-title text-primary">@ViewData["Title"]</h5>

            <form class="row g-3" asp-action="Edit" method="POST">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />

                <div class="col-md-12">
                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" placeholder="Email">
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">

                            <div class="form-floating mt-2">
                                <input asp-for="FirstName" class="form-control" placeholder="@Html.DisplayFor(model => model.FirstName)" />
                                <label asp-for="FirstName"></label>
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                        </div>
                        <div class="col-md-6">

                            <div class="form-floating mt-2">
                                <input asp-for="LastName" class="form-control" placeholder="@Html.DisplayFor(model => model.LastName)" />
                                <label asp-for="LastName"></label>
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="col-md-4">
                            <div class="form-floating mt-2">
                                <input asp-for="Phone" class="form-control" placeholder="@Html.DisplayFor(model => model.Phone)" />
                                <label asp-for="Phone"></label>
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating mt-2">
                                <input asp-for="Document" class="form-control" placeholder="@Html.DisplayFor(model => model.Document)" />
                                <label asp-for="Document"></label>
                                <span asp-validation-for="Document" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating mt-2">
                                <select asp-for="PrivateBlogRoleId" asp-items="Model.PrivateBlogRoles" class="form-control"></select>
                                <label asp-for="PrivateBlogRoleId"></label>
                                <span asp-validation-for="PrivateBlogRoleId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>
            </form>

        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}